{
  "manifest_version": 3,
  "name": "Auto Reject Cookies",
  "version": "1.1.0",
  "description": "Reject optional cookies automatically when a website offers a clear opt-out.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/consent-logic.js", "src/notice.js", "src/content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
